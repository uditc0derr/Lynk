generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links    Link[]
  qrCodes  QrCode[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Link {
  id          String    @id @default(cuid())
  slug        String    @unique
  destination String
  title       String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  disabled    Boolean   @default(false)
  expiresAt   DateTime?
  isQrTarget  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events Event[]
  qrCode QrCode?

  @@index([userId, createdAt])
}

model QrCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      QrType   @default(URL)
  content   Json
  config    Json
  dynamic   Boolean  @default(false)
  linkId    String?  @unique
  link      Link?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

enum QrType {
  URL
  TEXT
  EMAIL
  PHONE
  SMS
  WIFI
  VCARD
  LOCATION
}

model Event {
  id        String    @id @default(cuid())
  linkId    String
  link      Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId    String?
  kind      EventKind @default(CLICK)
  browser   String?
  os        String?
  device    String?
  referrer  String?
  country   String?
  createdAt DateTime  @default(now())

  @@index([linkId, createdAt])
  @@index([userId, createdAt])
}

enum EventKind {
  CLICK
  SCAN
}
